<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width,initial-scale=1" />
  <title>Mini Product Gallery - Demo</title>
  <style>
    :root{
      --bg:#f6f7fb;
      --card:#ffffff;
      --muted:#6b7280;
      --accent:#2563eb;
      --shadow: 0 6px 18px rgba(16,24,40,0.06);
      --radius:14px;
      font-family: Inter, system-ui, -apple-system, "Segoe UI", Roboto, "Helvetica Neue", Arial;
    }
    html,body{height:100%;margin:0;background:var(--bg);color:#111;}
    .container{max-width:1100px;margin:36px auto;padding:20px;}
    header{display:flex;align-items:center;justify-content:space-between;margin-bottom:20px;}
    h1{font-size:20px;margin:0;}
    .controls{display:flex;gap:12px;align-items:center;}
    input[type="search"]{
      padding:10px 12px;border-radius:10px;border:1px solid #e6e9ef;background:#fff;min-width:220px;
      outline:none;font-size:14px;
    }
    .cart{
      display:inline-flex;align-items:center;gap:8px;padding:8px 12px;border-radius:12px;background:var(--card);box-shadow:var(--shadow);
      cursor:pointer;
    }
    .cart .count{background:var(--accent);color:#fff;padding:4px 8px;border-radius:999px;font-weight:600;font-size:13px;}
    .grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(220px,1fr));gap:18px;margin-top:14px;}
    .card{background:var(--card);border-radius:12px;padding:14px;box-shadow:var(--shadow);display:flex;flex-direction:column;gap:10px;}
    .thumb{height:160px;border-radius:10px;background:linear-gradient(135deg,#f0f3ff,#eef6ff);display:flex;align-items:center;justify-content:center;font-weight:700;color:var(--muted);}
    .title{font-weight:700;font-size:15px;}
    .desc{color:var(--muted);font-size:13px;margin-top:6px;flex:1;}
    .meta{display:flex;justify-content:space-between;align-items:center;gap:10px;margin-top:8px;}
    .price{font-weight:800;}
    .btn{
      background:var(--accent);color:#fff;border:none;padding:8px 10px;border-radius:10px;cursor:pointer;font-weight:700;
      box-shadow: 0 6px 12px rgba(37,99,235,0.12);
    }
    @media (max-width:420px){
      .thumb{height:120px}
      .container{padding:12px}
    }
    /* small toast */
    .toast{
      position:fixed;right:20px;bottom:20px;background:#111;color:#fff;padding:10px 14px;border-radius:12px;opacity:0;transform:translateY(10px);
      transition: all .36s cubic-bezier(.2,.9,.3,1);pointer-events:none;
    }
    .toast.show{opacity:1;transform:none;pointer-events:auto;}
  </style>
</head>
<body>
  <div class="container">
    <header>
      <h1>Mini Store — Demo</h1>
      <div class="controls">
        <input id="search" type="search" placeholder="Search products (try: 'Laptop' or 'Headphone')" />
        <div id="cartBtn" class="cart" title="View cart">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" aria-hidden><path d="M3 3h2l1 9h11l1-6H6" stroke="#374151" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"/></svg>
          <div class="count" id="cartCount">0</div>
        </div>
      </div>
    </header>

    <main>
      <div id="products" class="grid" aria-live="polite"></div>
    </main>
  </div>

  <div id="toast" class="toast" role="status" aria-live="polite">Added to cart</div>

  <script>
    // Sample product data (would normally come from a backend)
    const PRODUCTS = [
      { id: 1, title: 'Ultra Laptop 14"', desc: 'Lightweight performance for students & devs', price: 42999, tag: 'Laptop' },
      { id: 2, title: 'Studio Headphones', desc: 'Over-ear, noise-isolating, comfy padding', price: 3499, tag: 'Headphone' },
      { id: 3, title: 'Wireless Mouse', desc: 'Ergonomic, long battery life', price: 899, tag: 'Accessory' },
      { id: 4, title: 'Mechanical Keyboard', desc: 'Tactile switches, RGB', price: 3799, tag: 'Accessory' },
      { id: 5, title: 'Portable SSD 1TB', desc: 'Fast NVMe speeds in a small form-factor', price: 7999, tag: 'Storage' },
      { id: 6, title: 'Noise-Cancelling Earbuds', desc: 'Compact, great call quality', price: 2499, tag: 'Headphone' },
    ];

    // Tiny in-memory cart: { productId: quantity }
    const cart = {};

    const productsEl = document.getElementById('products');
    const cartCountEl = document.getElementById('cartCount');
    const toast = document.getElementById('toast');
    const searchInput = document.getElementById('search');

    // render product cards
    function render(list) {
      productsEl.innerHTML = '';
      if (list.length === 0) {
        productsEl.innerHTML = '<p style="grid-column:1/-1;color:var(--muted)">No products match your search.</p>';
        return;
      }
      for (const p of list) {
        const card = document.createElement('article');
        card.className = 'card';
        card.innerHTML = `
          <div class="thumb" aria-hidden>${p.title.split(' ')[0]}</div>
          <div>
            <div class="title">${p.title}</div>
            <div class="desc">${p.desc}</div>
            <div class="meta">
              <div class="price">₹${numberWithCommas(p.price)}</div>
              <div style="display:flex;gap:8px">
                <button class="btn add" data-id="${p.id}">Add</button>
                <button class="btn" style="background:#e6e9ef;color:#111" data-id="${p.id}" aria-label="Quick buy">Buy</button>
              </div>
            </div>
          </div>
        `;
        productsEl.appendChild(card);
      }
      // attach handlers to add buttons
      document.querySelectorAll('.add').forEach(b=>{
        b.addEventListener('click', e=>{
          const id = Number(b.dataset.id);
          addToCart(id);
        });
      });
      document.querySelectorAll('button[aria-label="Quick buy"]').forEach(b=>{
        b.addEventListener('click', ()=>{
          alert('Quick buy demo — integrate payment gateway to complete purchase.');
        });
      });
    }

    // helpers
    function numberWithCommas(x){
      return x.toString().replace(/\B(?=(\d{3})+(?!\d))/g,",");
    }

    function addToCart(productId){
      cart[productId] = (cart[productId] || 0) + 1;
      updateCartUI();
      showToast('Added to cart ✓');
    }

    function updateCartUI(){
      const totalItems = Object.values(cart).reduce((s,n)=>s+n,0);
      cartCountEl.textContent = totalItems;
    }

    function showToast(msg = 'Done'){
      toast.textContent = msg;
      toast.classList.add('show');
      clearTimeout(toast._t);
      toast._t = setTimeout(()=>toast.classList.remove('show'), 1600);
    }

    // search
    function applySearch(){
      const q = searchInput.value.trim().toLowerCase();
      if (!q) render(PRODUCTS);
      else {
        const filtered = PRODUCTS.filter(p =>
          p.title.toLowerCase().includes(q) ||
          p.desc.toLowerCase().includes(q) ||
          p.tag.toLowerCase().includes(q)
        );
        render(filtered);
      }
    }

    // init
    render(PRODUCTS);
    updateCartUI();

    // events
    searchInput.addEventListener('input', debounce(applySearch, 220));
    document.getElementById('cartBtn').addEventListener('click', ()=> {
      const items = Object.entries(cart).map(([id,qty])=>{
        const p = PRODUCTS.find(x=>x.id==id);
        return `${p.title} × ${qty}`;
      });
      if (items.length === 0) alert('Cart is empty.');
      else alert('Cart:\n\n' + items.join('\n'));
    });

    // small debounce util
    function debounce(fn, ms){
      let t;
      return (...args)=>{
        clearTimeout(t);
        t = setTimeout(()=>fn(...args), ms);
      };
    }
  </script>
</body>
</html>
